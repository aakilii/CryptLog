# Deploy Next.js UI from frontend/ (not the Python API under backend/).
# IMPORTANT: use /backend/app/ patterns (root-only) — plain "app/" also ignores frontend/app/

# Python / FastAPI — use Render for backend, not this Vercel project
backend/pyproject.toml
backend/uv.lock
backend/requirements.txt
backend/.python-version
.venv/
venv/
/backend/data/

# Ignore Python tree under backend/, but keep Operation Room frontend sources for @operation-room imports
/backend/app/*
!/backend/app/phase_5_CISC/
/backend/app/phase_5_CISC/*
!/backend/app/phase_5_CISC/operation-room/
/backend/app/phase_5_CISC/operation-room/*
!/backend/app/phase_5_CISC/operation-room/frontend/
/backend/app/phase_5_CISC/operation-room/frontend/*
!/backend/app/phase_5_CISC/operation-room/frontend/src/
!/backend/app/phase_5_CISC/operation-room/frontend/tailwind.config.js

# Caches / local
node_modules/
__pycache__/
*.pyc
.env
.env.*

# Docs / tests
**/tests/
**/*.md

# ==============================================================================
# CryptLOG Next.js Frontend — Environment Configuration
# Copy to `frontend/.env.local` for local development:
#   cp frontend/.env.example frontend/.env.local
# On Vercel, set these in Project Settings -> Environment Variables.
# Never commit `frontend/.env.local` or real API keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend API & WebSocket Origins (Phases 1-4 Monolith)
# ------------------------------------------------------------------------------
# Public FastAPI backend base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional explicit WebSocket origin (derived from NEXT_PUBLIC_API_URL if omitted)
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. Phase 5 Operation Room Integration
# ------------------------------------------------------------------------------
# Server-side rewrite target for /api/deep-research/* (defaults to ${NEXT_PUBLIC_API_URL}/api/phase5)
OPROOM_BACKEND_ORIGIN=http://127.0.0.1:8000/api/phase5

# Optional client-exposed Operation Room backend override
# NEXT_PUBLIC_OPROOM_BACKEND_ORIGIN=http://127.0.0.1:8000/api/phase5

# Standalone Operation Room UI origin (only used when running it separately on :3001)
# NEXT_PUBLIC_OPERATION_ROOM_APP_URL=http://127.0.0.1:3001
# NEXT_PUBLIC_OPERATION_ROOM_UI_ORIGIN=http://127.0.0.1:3001
# NEXT_PUBLIC_OR_OPERATION_HOME=/operation-room

# ------------------------------------------------------------------------------
# 3. Phase 4 Magic Query — AI SQL Generator (OPTIONAL)
#    Server-side only (used in /api/magic-query/generate).
#    If omitted, Magic Query automatically falls back to local rule-based SQL.
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=your-google-ai-studio-key

# ------------------------------------------------------------------------------
# 4. Google Drive Ingestion Picker (OPTIONAL)
#    Only required if importing logs directly from Google Drive in the UI.
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_GOOGLE_API_KEY=
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 5. Demo Mode (OPTIONAL)
# ------------------------------------------------------------------------------
# Set to true or 1 to enable UI demo mode
# NEXT_PUBLIC_CSIC_DEMO_MODE=false


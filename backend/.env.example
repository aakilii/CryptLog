# ==============================================================================
# Forensic AI Engine (FastAPI) — Backend Environment Configuration
# Copy to `backend/.env` and fill in values for your environment:
#   cp backend/.env.example backend/.env
# Never commit `backend/.env` or real API keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application & Security
# ------------------------------------------------------------------------------
APP_NAME=Forensic AI Engine
DEBUG=true

# Required in production for JWT signing (generate with: openssl rand -hex 32)
SECRET_KEY=change-this-secret-key-in-production-use-openssl-rand-hex-32

# Base URL of the backend (used for webhook/link generation when applicable)
# BASE_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. Database & Local Storage Paths (defaults match app/config.py)
#    On Vercel (VERCEL=1), storage automatically redirects under /tmp/csic-data
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///data/ledger.db
SQLITE_DB_PATH=data/ledger.db
RAW_STORAGE_PATH=data/raw
PARQUET_STORAGE_PATH=data/parquet
WORM_STORAGE_PATH=data/worm
QUARANTINE_PATH=data/quarantine
TEMP_CHUNKS_PATH=data/temp

# ------------------------------------------------------------------------------
# 3. Phase 1 — JIT Ingestion
# ------------------------------------------------------------------------------
SESSION_TTL_MINUTES=30

# Set to false to disable automatic Phase 2 processing after log ingestion
# AUTO_TRIGGER_PHASE2=true

# ------------------------------------------------------------------------------
# 4. Phase 2 -> Phase 3 Pipeline & Hot/Cold Tiered Storage
# ------------------------------------------------------------------------------
# PHASE3_WEBHOOK_URL=http://127.0.0.1:8000/api/phase3/phase2_webhook
# PHASE3_HOT_DB_PATH=data/phase3_hot.duckdb
# PHASE3_COLD_DIR=data/phase3_cold
# PHASE3_TTL_SECONDS=30
# PHASE3_PRIVACY_BYPASS=false

# ------------------------------------------------------------------------------
# 5. Phase 3 — AWS S3 / MinIO Cold Storage (OPTIONAL)
#    Leave blank to use local Parquet storage in PHASE3_COLD_DIR.
# ------------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=
# S3_ENDPOINT_URL=http://localhost:9000

# ------------------------------------------------------------------------------
# 6. Phase 5 Operation Room — LLM Provider
#    Default is local Ollama (no API key required).
#    Set OPROOM_LLM_PROVIDER=gemini (or openai) only if using cloud LLMs.
# ------------------------------------------------------------------------------
OPROOM_LLM_PROVIDER=ollama
OPROOM_LLM_MODEL=llama3.2
OPROOM_OLLAMA_URL=http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434

# Optional tuning overrides for LLM calls
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=4096

# Google Gemini (only needed when OPROOM_LLM_PROVIDER=gemini)
# Get keys from: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# OPROOM_GEMINI_API_KEY=
# OPROOM_GEMINI_API_KEYS=your-gemini-key-1,your-gemini-key-2
# OPROOM_KEY_ROTATION=round_robin   # round_robin | random | least_used

# OpenAI (only needed when OPROOM_LLM_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_API_KEYS=

# ------------------------------------------------------------------------------
# 7. Phase 5 Operation Room — Local Embeddings, Vector Store & DuckDB
# ------------------------------------------------------------------------------
# OPROOM_EMBEDDING_MODEL=all-MiniLM-L6-v2   # all-MiniLM-L6-v2 | all-mpnet-base-v2
# OPROOM_EMBEDDING_DEVICE=auto              # auto | cpu | cuda
# OPROOM_EMBEDDING_BATCH_SIZE=32
# OPROOM_EMBEDDING_DIMENSION=384            # 384 for MiniLM, 768 for mpnet
# OPROOM_VECTOR_STORE_PATH=./data/vectordb
# OPROOM_VECTOR_STORE_RESET_ON_STARTUP=false
# OPROOM_GLOBAL_DB_PATH=./data/global.duckdb

# ------------------------------------------------------------------------------
# 8. Phase 5 Operation Room — Neo4j GraphRAG (OPTIONAL)
# ------------------------------------------------------------------------------
# OPROOM_NEO4J_HOME=
# OPROOM_NEO4J_CONTAINER_NAME=neo4j
# OPROOM_NEO4J_SERVICE_NAME=Neo4j
# OPROOM_NEO4J_START_COMMAND=

# ------------------------------------------------------------------------------
# 9. Phase 5 Operation Room — Hashing, Chain-of-Custody, Signing & Security
# ------------------------------------------------------------------------------
# OPROOM_HASH_ALGORITHM=sha256              # sha256 | sha512 | blake2b
# OPROOM_COC_VERBOSITY=STANDARD
# OPROOM_ADMIN_TOKEN=
# OPROOM_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]

# Cryptographic report signing (OPTIONAL — defaults to local/unsigned if unset)
# NFLIP_SIGNING_MODE=
# NFLIP_SIGNER_NAME=
# NFLIP_SIGNING_CERT_PATH=
# NFLIP_SIGNING_KEY_PATH=
# NFLIP_TSA_URL=
# NFLIP_HSM_VAULT_URL=
# NFLIP_HSM_KEY_NAME=

# ------------------------------------------------------------------------------
# 10. Background Workers (OPTIONAL — Redis / Celery)
# ------------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
